{
  "version": 1,
  "canisters": {
    "qicp_token": {
      "type": "rust",
      "candid": "canisters/qicp_token/qicp_token.did",
      "package": "qicp_token"
    },
    "treasury": {
      "type": "rust",
      "candid": "canisters/treasury/treasury.did",
      "package": "treasury"
    },
    "x402_bazaar": {
      "type": "rust",
      "candid": "canisters/x402_bazaar/x402_bazaar.did",
      "package": "x402_bazaar"
    },
    "conway_engine": {
      "type": "rust",
      "candid": "canisters/conway_engine/conway_engine.did",
      "package": "conway_engine"
    },
    "frontend": {
      "type": "assets",
      "source": [
        "frontend"
      ]
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": [
        "https://ic0.app",
        "https://icp-api.io"
      ],
      "type": "persistent"
    }
  }
}
